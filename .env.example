# ==============================================================================
# OPSRECALL - Environment Configuration
# ==============================================================================
# Copy this file to .env and configure your keys before running OPSRECALL.

# Hindsight Cloud Configuration
# Get your API key from https://hindsight.vectorize.io/
HINDSIGHT_API_KEY=your_hindsight_api_key_here
HINDSIGHT_BANK_ID=opsrecall-demo
HINDSIGHT_TEST_BANK_ID=opsrecall-live-tests
# Optional base URL override (leave blank to use Hindsight Cloud default):
HINDSIGHT_BASE_URL=

# Groq LLM Configuration
# Get your API key from https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here
# Migrated to official recommended Groq production model (131k context, ~500 tps):
GROQ_MODEL=openai/gpt-oss-120b

# Application Persistence (SQLite for local audit logs and evaluation results)
SQLITE_DB_PATH=opsrecall.db

# Operational Settings
OPSRECALL_ENV=development

